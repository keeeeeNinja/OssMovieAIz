# 視聴者向け: このファイルを ~/.config/ossmovie/.env にコピーして、各値を埋めてください
# 開発者向け: プロジェクトルートに .env を置く運用も可能（スクリプトが両対応）
#
# セットアップ手順:
#   mkdir -p ~/.config/ossmovie
#   cp .env.example ~/.config/ossmovie/.env
#   その後、~/.config/ossmovie/.env を開いて各値を入力

# RunPod 認証
RUNPOD_API_KEY=

# RunPod 共通
RUNPOD_VOLUME_ID=c1dbeweh5j

# RunPod S3 互換 API（Network Volume アクセス用）
RUNPOD_S3_ENDPOINT=https://s3api-eu-ro-1.runpod.io
RUNPOD_S3_ACCESS_KEY=
RUNPOD_S3_SECRET_KEY=
RUNPOD_S3_REGION=EU-RO-1

# RunPod Serverless Endpoints（create_serverless_endpoint.py 実行後に追記）
RUNPOD_ENDPOINT_FLUX=
RUNPOD_ENDPOINT_I2V=

# HuggingFace（モデルダウンロードで gated リポジトリにアクセスする場合）
HF_TOKEN=

# Serverless 用 Custom Image
SERVERLESS_IMAGE=ghcr.io/keeeeeninja/ossmovie-comfyui:v1.0.0
