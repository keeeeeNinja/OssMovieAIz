{
  "_comment": "Flux Schnell GGUF 静止画ワークフロー (商用利用可・LoRAなし)。プレースホルダ: [PROMPT] [WIDTH] [HEIGHT] [SEED] [STEPS] [OUTPUT_PREFIX]。Schnell は CFG=1.0 / steps=4 が必須仕様。UnetLoaderGGUF (ComfyUI-GGUF) を使用。",
  "3": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "flux1-schnell-Q8_0.gguf"
    }
  },
  "4": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "[PROMPT]", "clip": ["4", 0] }
  },
  "10": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": "[WIDTH]", "height": "[HEIGHT]", "batch_size": 1 }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0],
      "positive": ["6", 0],
      "negative": ["6", 0],
      "latent_image": ["10", 0],
      "seed": "[SEED]",
      "steps": "[STEPS]",
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["11", 0], "vae": ["5", 0] }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": { "images": ["12", 0], "filename_prefix": "[OUTPUT_PREFIX]" }
  }
}
